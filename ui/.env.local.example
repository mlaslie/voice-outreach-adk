# Copy to .env.local for `npm run dev`. All values here are fictional.

# --------------- Server-side only (never reaches the browser) ---------------
# The backend API. The browser never calls it: every request goes to this
# app's same-origin /api/backend/* route, which forwards to
# ${API_BASE_URL}/api/<path>. For a deployed backend this is its Cloud Run
# URL, which is also the audience of the Google-signed ID token the route
# attaches. A http://localhost URL gets no token (local development).
API_BASE_URL=http://localhost:8081

# --------------- Branding (src/lib/site.ts) ---------------------------------
# NEXT_PUBLIC_* values are compiled into the client bundle: no secrets, no
# backend URLs. They appear in the SMS consent statement, so ORG_NAME must
# match the backend's configured organisation name.
NEXT_PUBLIC_ORG_NAME=Acme Health
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.org
NEXT_PUBLIC_PRIVACY_URL=https://example.org/privacy
NEXT_PUBLIC_TERMS_URL=https://example.org/terms

# Optional logos for the nurse console (/nurse): a path under public/ (e.g.
# /brand/logo.svg — public/brand/ is gitignored) or a full URL. Unset shows a
# generic placeholder mark.
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_LOGO_WIDE_URL=
