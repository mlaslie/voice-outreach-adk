# Copy to terraform.tfvars (gitignored).
project_id         = "your-gcp-project-id"
region             = "us-central1"
firestore_location = "nam5"
name_prefix        = "voa"

# Optional budget alert (needs billing.budgets.create on the billing account).
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# monthly_budget_usd = 200

# Throwaway test projects only: allows terraform destroy to remove data.
# protect_data = false

# SMS follow-up. Option 3 (the questionnaire by text) stays off until its copy
# is registered with the carrier; sms_dry_run (default true) logs instead of sending.
sms_survey_enabled = false
# Sharing the SMS number with another system (docs/sms-number-switch.md)
sms_switch_enabled   = false
sms_peer_webhook_url = "" # e.g. https://<other-sms-service>/api/sms-inbound
# Cloud Run answers on two hostnames; list the other form of each (read-only matching)
sms_peer_webhook_aliases = ""
sms_self_webhook_aliases = "" # e.g. https://<gateway status.url>/twilio/sms
