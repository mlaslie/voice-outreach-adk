# Copy to terraform.tfvars (gitignored).
project_id         = "your-gcp-project-id"
region             = "us-central1"
firestore_location = "nam5"
name_prefix        = "voa"

# Optional budget alert (needs billing.budgets.create on the billing account).
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# monthly_budget_usd = 200

# Throwaway test projects only: allows terraform destroy to remove data.
# protect_data = false

# SMS follow-up. Option 3 (the questionnaire by text) stays off until its copy
# is registered with the carrier; sms_dry_run (default true) logs instead of sending.
sms_survey_enabled = false
# DEMO ONLY: all 24 languages callable and textable; wording without an approved
# pack is a draft or machine-translated (unreviewed). Never with real patients.
languages_auto_approve = true
# Warm instances (cost vs cold starts); the gateway defaults to 1
# api_min_instances   = 1
# ui_min_instances    = 1
# nurse_min_instances = 1
# Admin console (APP_MODE=admin build of the dashboard); its own IAP list
iap_admin_members = [] # e.g. ["user:admin@example.org"]
# admin_min_instances = 1
